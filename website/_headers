/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; connect-src 'self'; font-src 'self'; object-src 'self'; frame-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'

# Keep cache rules disjoint: Pages joins duplicate matching header values.
# Explicit no-cache prevents a zone Browser Cache TTL from lengthening max-age=0.
/
  Cache-Control: public, no-cache, no-transform, max-age=0, must-revalidate

/*.html
  Cache-Control: public, no-cache, no-transform, max-age=0, must-revalidate

/resume
  Cache-Control: public, no-cache, no-transform, max-age=0, must-revalidate

/404
  Cache-Control: public, no-cache, no-transform, max-age=0, must-revalidate

/*.js
  Cache-Control: public, no-cache, max-age=0, must-revalidate

/*.css
  Cache-Control: public, no-cache, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, no-cache, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, no-cache, max-age=0, must-revalidate

# Journey plates and textures have content hashes in their names.
/assets/journey/high/*
  Cache-Control: public, max-age=31536000, immutable

/assets/journey/mid/*
  Cache-Control: public, max-age=31536000, immutable

/assets/journey/low/*
  Cache-Control: public, max-age=31536000, immutable

/assets/journey/manifest.json
  Cache-Control: public, no-cache, max-age=0, must-revalidate

/assets/journey/poster.webp
  Cache-Control: public, max-age=86400

/assets/work/*
  Cache-Control: public, max-age=86400

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/social-preview.jpg
  Cache-Control: public, no-cache, max-age=0, must-revalidate

/assets/Vadla-Hemanth-Resume.pdf
  Content-Type: application/pdf
  Content-Disposition: inline; filename="Vadla-Hemanth-Resume.pdf"
  Cache-Control: public, no-cache, max-age=0, must-revalidate
