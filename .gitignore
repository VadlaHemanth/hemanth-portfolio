# Track shipping code and web assets, not personal records or production scratch.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/website/
!/design/
!/scripts/
!/docs/
!/skills/
!/.github/

/website/downloads/
/website/qa/
/website/tmp/
/website/node_modules/
/website/.wrangler/
/website/dist/
/website/.env
/website/.env.*
/website/*.log

# The v2 film archive stays local; the v3 journey ships small WebP plates instead.
/website/assets/motion/

/design/*
!/design/build_resume.py
!/design/resume-data.json
!/design/build_social_preview.py

**/__pycache__/
**/*.pyc
**/.DS_Store
**/node_modules/
**/.env
**/.env.*
**/.wrangler/
**/*.log
**/*credentials*
**/*secret*
**/*token*
**/about-me.txt
